/*
DISPOSIÇÃO DE PINOS
GPIO32 - Acelerador
GPIO33 - Temperatura
GPIO26  - Botão ON/OFF
GPIO 18,19,21,22 - Bits do display
GPIO14  - IN2 ponte H
GPIO13  - IN1 ponte H
TX2/GPIO17 - liga o display
RX2/GPIO16 - Seleciona se o display recebe comandos ou dados
GPIO25 - Chave de ré

**O controleVelocidade foi retirado, pois o pwm é feito pelo esp
*/

#include <LiquidCrystal.h>

LiquidCrystal lcd(GPIO_NUM_16, GPIO_NUM_17, GPIO_NUM_18, GPIO_NUM_19, GPIO_NUM_21, GPIO_NUM_22);

const int pinAcelerador      = GPIO_NUM_32;
const int pinTemperatura     = GPIO_NUM_33;
const int pinONOFF           = GPIO_NUM_26;
const int bit1               = GPIO_NUM_18;
const int bit2               = GPIO_NUM_19;
const int bit3               = GPIO_NUM_21;
const int bit4               = GPIO_NUM_22;
const int pinSentido1        = GPIO_NUM_13;
const int pinSentido2        = GPIO_NUM_14;
const int ligaDisplay        = GPIO_NUM_17;
const int displayReg         = GPIO_NUM_16;
const int chaveRe            = GPIO_NUM_25;


//criando caracter customizado
byte grau = 0;
byte customChar[] = {
  B00100, B01010, B00100, B00000,
  B00000, B00000, B00000, B00000
};

//variaveis de estado
bool estadoBotaoAnterior = false;
bool estadoSistema       = false;

// Controle de mudança de sentido e rampa
bool estadoChaveReAntigo = false;
int pwmAtual = 0; // Armazena a velocidade atual aplicada no pino PWM

//configuracoes do pwm ESP32
const int canalPWM = 0; // escolhe um canal do modulo pwm dentro do esp
const int frequenciaPWM = 5000; 
const int resolucaoPWM = 8; // resolucao de 0 a 255 pois o codigo opera deste jeito 


void setup() {
    pinMode(pinAcelerador, INPUT);
    pinMode(pinTemperatura, INPUT);
    pinMode(pinONOFF, INPUT);
    pinMode(chaveRe, INPUT);
    
    pinMode(pinSentido1, OUTPUT);
    pinMode(pinSentido2, OUTPUT);
    pinMode(bit4, OUTPUT);
    pinMode(bit3, OUTPUT);
    pinMode(bit2, OUTPUT);
    pinMode(bit1, OUTPUT);
    pinMode(displayReg, OUTPUT);
    pinMode(ligaDisplay, OUTPUT);

    lcd.begin(16, 2);
    lcd.clear();
    
    lcd.setCursor(0, 0);
    lcd.print("Trainee 2026/2");
    delay(2000);
    lcd.clear();

    lcd.createChar(grau, customChar);
    
    // Leitura inicial do estado da chave
    estadoChaveReAntigo = digitalRead(chaveRe);

    //pwm
    ledcSetup(canalPWM, frequenciaPWM, resolucaoPWM); // configura o pwm
    ledcAttachPin(controleVelocidade, canalPWM); //escolhe o pino do pwm e associa ao canal
}

void loop() {
    // 1 - Lógica do botão ON/OFF
    bool estadoBotaoAtual = digitalRead(pinONOFF);
    if (estadoBotaoAtual == HIGH && estadoBotaoAnterior == LOW) {
        estadoSistema = !estadoSistema;
        lcd.clear();
        delay(200); // Debounce
    }
    estadoBotaoAnterior = estadoBotaoAtual;
    
    // 2 - Leitura do sensor TMP36
    int leituraTempSensor = analogRead(pinTemperatura);
    float temperatura = ((leituraTempSensor *3300.0 / 4095.0) - 500.0) / 10.0;
    
    // 3 - Leitura do acelerador
    int leituraAcel = analogRead(pinAcelerador);
    int percentualAcel = map(leituraAcel, 0, 4095, 0, 100);
    int valorPWM = map(leituraAcel, 0, 4095, 0, 255);

    // 4 - Estado da chave de ré
    bool estadoChaveReAtual = digitalRead(chaveRe);

    // BARCO DESLIGADO
    
    if (!estadoSistema) {
        pwmAtual = 0;       // adicionou o pwm = 0
        ledcWrite(canalPWM, 0);
        digitalWrite(pinSentido1, LOW);
        digitalWrite(pinSentido2, LOW);
        
        lcd.setCursor(0, 0);
        lcd.print("Status: OFF     ");
    }
    // BARCO LIGADO
    else {
        // Exibição no Display
        lcd.setCursor(0, 0);
        lcd.print("T:");
        lcd.print((int)temperatura);
        lcd.write(grau);
        lcd.print("C ");

        lcd.print("Ac:");
        if (estadoChaveReAtual) {   // tiou o digital read da chave de re e colocou a comparação direto no estado 
            lcd.print("-");
        } else {
            lcd.print(" ");
        }
        lcd.print(percentualAcel);
        lcd.print("%   ");
        
        lcd.setCursor(0, 1);
        lcd.print("St:ON   ");

        if (estadoChaveReAtual) {
            lcd.print("Dir:RE ");
        } else {
            lcd.print("Dir:FRT");
        }

        // DETECÇÃO DE MUDANÇA DE MARCHA 
        if (estadoChaveReAtual != estadoChaveReAntigo) {
            // Rampa de desaceleração até 0
            while (pwmAtual > 0) {
                pwmAtual--;
                ledcWrite(canalPWM, pwmAtual);
                delay(5);
            }

            // Inverte a Ponte H após a parada completa
            if (estadoChaveReAtual) {
                digitalWrite(pinSentido1, HIGH);
                digitalWrite(pinSentido2, LOW);
            } else {
                digitalWrite(pinSentido1, LOW);
                digitalWrite(pinSentido2, HIGH);
            }

            // Rampa de aceleração até o valor alvo do acelerador
            while (pwmAtual < valorPWM) {
                pwmAtual++;
                ledcWrite(canalPWM, pwmAtual);
                delay(5);
            }

            estadoChaveReAntigo = estadoChaveReAtual;
        } 
        else {
            // Operação normal: Ajusta os sentidos e atualiza a velocidade
            if (estadoChaveReAtual) {
                digitalWrite(pinSentido1, HIGH);
                digitalWrite(pinSentido2, LOW);
            } else {
                digitalWrite(pinSentido1, LOW);
                digitalWrite(pinSentido2, HIGH);
            }

            pwmAtual = valorPWM;
            ledcWrite(canalPWM, pwmAtual);
        }
    }
}
