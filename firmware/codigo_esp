#include <LiquidCrystal.h>
#include <WiFi.h>
#include <HTTPClient.h>

// CONFIGURAÇÕES DE REDE
const char* ssid      = "nome-wifi";
const char* password  = "senha";
const char* serverUrl = "http://(ip-pc):3001/telemetria"; // IPv4 notebook

// Pinos do display (RS, E, DB4, DB5, DB6, DB7)
LiquidCrystal lcd(16, 17, 18, 19, 21, 22);

// Pinos de entrada
const int pinAcelerador  = 32;
const int pinTemperatura = 33;
const int pinONOFF       = 26;
const int chaveRe        = 25;

// Pinos de saída do motor
const int pinSentido1    = 13; // IN1
const int pinSentido2    = 14; // IN2

// Caractere customizado de grau
byte grau = 0;
byte customChar[] = {
  B00100, B01010, B00100, B00000,
  B00000, B00000, B00000, B00000
};

// Estados do sistema
bool estadoBotaoAnterior = false;
bool estadoSistema       = false;
bool estadoChaveReAntigo = false;
int pwmAtual             = 0;

// Configurações do PWM ESP32
const int frequenciaPWM = 5000;
const int resolucaoPWM  = 8; // 0 a 255

// Controle de tempo para envio HTTP sem bloquear o motor
unsigned long ultimoEnvio = 0;
const unsigned long intervaloEnvio = 500; // envia a cada 500 ms (2x por segundo)

void setup() {
  Serial.begin(115200);

  // entradas
  pinMode(pinAcelerador, INPUT);
  pinMode(pinTemperatura, INPUT);
  // entradas com pull-down interno  
  pinMode(pinONOFF, INPUT_PULLDOWN);
  pinMode(chaveRe, INPUT_PULLDOWN);

  // Configura PWM da Ponte H
  ledcAttach(pinSentido1, frequenciaPWM, resolucaoPWM);
  ledcAttach(pinSentido2, frequenciaPWM, resolucaoPWM);
  ledcWrite(pinSentido1, 0);
  ledcWrite(pinSentido2, 0);

  // Inicializa LCD
  lcd.begin(16, 2);
  lcd.createChar(grau, customChar);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Trainee 2026/2");
  lcd.setCursor(0, 1);
  lcd.print("Conectando WiFi");

  // Conecta ao Wi-Fi (com limite de 10s para não travar a bancada se estiver sem rede)
  WiFi.begin(ssid, password);
  int tentativas = 0;
  while (WiFi.status() != WL_CONNECTED && tentativas < 20) {
    delay(500);
    Serial.print(".");
    tentativas++;
  }

  lcd.clear();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi conectado! IP ESP32: " + WiFi.localIP().toString());
    lcd.setCursor(0, 0);
    lcd.print("WiFi OK!");
  } else {
    Serial.println("\nFalha no Wi-Fi. Rodando modo local.");
    lcd.setCursor(0, 0);
    lcd.print("Sem WiFi");
  }
  delay(1500);
  lcd.clear();

  estadoChaveReAntigo = digitalRead(chaveRe);
}

void loop() {
  // Lógica do botão ON/OFF
  bool estadoBotaoAtual = digitalRead(pinONOFF);
  if (estadoBotaoAtual == HIGH && estadoBotaoAnterior == LOW) {
    estadoSistema = !estadoSistema;
    lcd.clear();
    delay(200);
  }
  estadoBotaoAnterior = estadoBotaoAtual;

  // Leitura de temperatura (TMP36)
  int leituraTempSensor = analogRead(pinTemperatura);
  float temperatura = ((leituraTempSensor * 3300.0 / 4095.0) - 500.0) / 10.0;

  // Leitura do acelerador e da chave de ré
  int leituraAcel = analogRead(pinAcelerador);
  int percentualAcel = map(leituraAcel, 0, 4095, 0, 100);
  int valorPWM = map(leituraAcel, 0, 4095, 0, 255);
  bool estadoChaveReAtual = digitalRead(chaveRe);

  // Controle do motor e display
  if (!estadoSistema) {
    pwmAtual = 0;
    ledcWrite(pinSentido1, 0);
    ledcWrite(pinSentido2, 0);
    estadoChaveReAntigo = estadoChaveReAtual;

    lcd.setCursor(0, 0);
    lcd.print("Status: OFF     ");
    lcd.setCursor(0, 1);
    lcd.print("                ");
  } else {
    lcd.setCursor(0, 0);
    lcd.print("T:");
    lcd.print((int)temperatura);
    lcd.write(grau);
    lcd.print("C Ac:");
    lcd.print(estadoChaveReAtual ? "-" : " ");
    lcd.print(percentualAcel);
    lcd.print("%   ");

    lcd.setCursor(0, 1);
    lcd.print("St:ON   ");
    lcd.print(estadoChaveReAtual ? "Dir:RE " : "Dir:FRT");

    if (estadoChaveReAtual != estadoChaveReAntigo) {
      if (pwmAtual > 0) {
        pwmAtual--;
      } else {
        estadoChaveReAntigo = estadoChaveReAtual;
      }
    } else {
      if (pwmAtual < valorPWM) {
        pwmAtual++;
      } else if (pwmAtual > valorPWM) {
        pwmAtual--;
      }
    }

    if (estadoChaveReAntigo) {
      ledcWrite(pinSentido1, 0);
      ledcWrite(pinSentido2, pwmAtual);
    } else {
      ledcWrite(pinSentido2, 0);
      ledcWrite(pinSentido1, pwmAtual);
    }
  }

  // Envio de telemetria via HTTP POST a cada 500 ms
  if (millis() - ultimoEnvio >= intervaloEnvio) {
    ultimoEnvio = millis();

    if (WiFi.status() == WL_CONNECTED) {
      HTTPClient http;
      http.begin(serverUrl);
      http.addHeader("Content-Type", "application/json");
      http.setTimeout(1000); // evita travar o loop se a rede oscilar

      // Quando o barco está OFF envia 0% de aceleração para o gráfico
      int aceleracaoEnvio = estadoSistema ? percentualAcel : 0;

      // Monta o JSON com as chaves exatas que o backend e o frontend esperam
      String jsonPayload = "{";
      jsonPayload += "\"temperatura\":" + String(temperatura, 1) + ",";
      jsonPayload += "\"aceleracao\":" + String(aceleracaoEnvio) + ",";
      jsonPayload += "\"status\":" + String(estadoSistema ? "true" : "false") + ",";
      jsonPayload += "\"re\":" + String(estadoChaveReAntigo ? "true" : "false");
      jsonPayload += "}";

      int httpCode = http.POST(jsonPayload);

      if (httpCode > 0) {
        Serial.printf("POST OK (%d) -> %s\n", httpCode, jsonPayload.c_str());
      } else {
        Serial.printf("Erro no POST: %s\n", http.errorToString(httpCode).c_str());
      }

      http.end();
    }
  }

  delay(5);
}
